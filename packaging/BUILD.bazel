load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@bazel_lib//lib:expand_template.bzl", "expand_template")
load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_pkg//pkg:zip.bzl", "pkg_zip")

# Release assets, cross-built from any host with the hermetic toolchains:
#
#   bazel build --config=release //packaging:dist
#
# bazel-bin/packaging/dist then holds every archive and package, the installers, and SHA256SUMS. Asset names carry no
# version so that `releases/latest/download/...` URLs in the install scripts stay stable.

# Rust target triple -> Linux package architecture, or None. Linux binaries link musl statically.
TARGETS = {
    "aarch64-apple-darwin": None,
    "aarch64-pc-windows-gnullvm": None,
    "aarch64-unknown-linux-musl": "arm64",
    "x86_64-apple-darwin": None,
    "x86_64-pc-windows-gnullvm": None,
    "x86_64-unknown-linux-musl": "amd64",
}

BINARIES = {
    "ovr": "//crates/ovr",
    "ovrd": "//crates/ovrd",
}

PACKAGED = [triple for triple, arch in TARGETS.items() if arch]

PACKAGES = [
    "{}_{}".format(triple, packager)
    for triple in PACKAGED
    for packager in [
        "deb",
        "rpm",
    ]
]

[
    platform_transition_filegroup(
        name = "{}_{}".format(triple, binary),
        srcs = [label],
        tags = ["manual"],
        target_platform = "@rules_rs//rs/platforms:" + triple,
    )
    for triple in TARGETS
    for binary, label in BINARIES.items()
]

[
    pkg_files(
        name = triple + "_files",
        srcs = [":{}_{}".format(triple, binary) for binary in BINARIES],
        attributes = pkg_attributes(mode = "0755"),
        tags = ["manual"],
    )
    for triple in TARGETS
]

[
    pkg_zip(
        name = triple + "_archive",
        srcs = [
            ":{}_files".format(triple),
            "//:LICENSE",
        ],
        package_file_name = "ovr-{}.zip".format(triple),
        tags = ["manual"],
    ) if "windows" in triple else pkg_tar(
        name = triple + "_archive",
        srcs = [
            ":{}_files".format(triple),
            "//:LICENSE",
        ],
        extension = "tar.gz",
        package_file_name = "ovr-{}.tar.gz".format(triple),
        tags = ["manual"],
    )
    for triple in TARGETS
]

# Debian and RPM packages with nfpm. Bazel fills in the file paths and architecture; nfpm reads the version, which
# comes from Cargo.toml, from the environment.
[
    expand_template(
        name = triple + "_nfpm",
        out = triple + "_nfpm.yaml",
        substitutions = {"${ARCH}": TARGETS[triple]},
        tags = ["manual"],
        template = "nfpm.yaml",
    )
    for triple in PACKAGED
]

# nfpm keeps symlinks as symlinks, so the binaries are copied out of the sandbox's symlink tree first.
[
    genrule(
        name = "{}_{}".format(triple, packager),
        srcs = [
            ":{}_nfpm".format(triple),
            ":{}_ovr".format(triple),
            ":{}_ovrd".format(triple),
            "//:cargo_env",
        ],
        outs = ["ovr-{}.{}".format(triple, packager)],
        cmd = " ".join([
            "stage=$(@D)/{}_{}_stage &&".format(triple, packager),
            "mkdir -p $$stage &&",
            "cp -L $(location :{}_ovr) $(location :{}_ovrd) $$stage/ &&".format(triple, triple),
            "cp $(location :{}_nfpm) $$stage/nfpm.yaml &&".format(triple),
            "VERSION=$$(sed -n 's/^CARGO_PKG_VERSION=//p' $(location //:cargo_env))",
            "nfpm=$$PWD/$(execpath @multitool//tools/nfpm) target=$$PWD/$@ &&",
            "cd $$stage && SOURCE_DATE_EPOCH=0 VERSION=$$VERSION $$nfpm package --config nfpm.yaml",
            "--packager {} --target $$target".format(packager),
        ]),
        tags = ["manual"],
        tools = ["@multitool//tools/nfpm"],
    )
    for triple in PACKAGED
    for packager in [
        "deb",
        "rpm",
    ]
]

ASSETS = [":{}_archive".format(triple) for triple in TARGETS] + [":" + package for package in PACKAGES] + [
    "//:install.ps1",
    "//:install.sh",
]

genrule(
    name = "checksums",
    srcs = ASSETS,
    outs = ["SHA256SUMS"],
    cmd = " ".join([
        "coreutils=$$PWD/$(COREUTILS_BIN);",
        "for f in $(SRCS); do (cd $$(dirname $$f) && $$coreutils sha256sum $$(basename $$f)); done | sort -k2 > $@",
    ]),
    tags = ["manual"],
    toolchains = ["@bazel_lib//lib:coreutils_toolchain_type"],
)

copy_to_directory(
    name = "dist",
    srcs = ASSETS + [":checksums"],
    root_paths = [
        ".",
        "packaging",
    ],
    tags = ["manual"],
)
