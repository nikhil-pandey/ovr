load("@crates//ovr:data.bzl", "all_crate_deps", "crate_data")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

# The binary owns the package's default label, so first-party dependencies are listed by label.
LINT_CONFIG = crate_data().get("lint_config")

rust_library(
    name = "lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "ovr",
    lint_config = LINT_CONFIG,
    rustc_env_files = ["//:cargo_env"],
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ) + ["//crates/ovr-proto"],
)

rust_binary(
    name = "ovr",
    srcs = ["src/main.rs"],
    lint_config = LINT_CONFIG,
    rustc_env_files = ["//:cargo_env"],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ) + [
        ":lib",
        "//crates/ovr-proto",
    ],
)

rust_binary(
    name = "timing",
    srcs = ["examples/timing.rs"],
    lint_config = LINT_CONFIG,
    rustc_env_files = ["//:cargo_env"],
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
        normal_dev = True,
    ) + [":lib"],
)

rust_test(
    name = "test",
    size = "small",
    crate = ":lib",
    lint_config = LINT_CONFIG,
    rustc_env_files = ["//:cargo_env"],
    deps = all_crate_deps(
        cargo_only = True,
        normal_dev = True,
    ) + ["//crates/ovrd:lib"],
)

# Cargo's integration test, run against both release binaries.
rust_test(
    name = "e2e",
    size = "medium",
    srcs = ["tests/e2e.rs"],
    data = [
        ":ovr",
        "//crates/ovrd",
    ],
    lint_config = LINT_CONFIG,
    rustc_env = {
        "CARGO_BIN_EXE_ovr": "$(rootpath :ovr)",
        "OVRD": "$(rootpath //crates/ovrd)",
    },
    rustc_env_files = ["//:cargo_env"],
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
        normal_dev = True,
    ) + ["//crates/ovr-proto"],
)
