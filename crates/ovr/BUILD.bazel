load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "cargo_toml_env_vars")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

cargo_toml_env_vars(
    name = "cargo_env",
    src = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    aliases = aliases(),
    crate_name = "ovr",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env_files = [":cargo_env"],
    deps = all_crate_deps(normal = True) + ["//crates/ovr-proto"],
)

rust_binary(
    name = "ovr",
    srcs = ["src/main.rs"],
    aliases = aliases(),
    rustc_env_files = [":cargo_env"],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True) + [
        ":lib",
        "//crates/ovr-proto",
    ],
)

rust_test(
    name = "test",
    size = "small",
    crate = ":lib",
    rustc_env_files = [":cargo_env"],
    deps = all_crate_deps(normal_dev = True) + ["//crates/ovrd:lib"],
)

rust_test(
    name = "e2e",
    size = "medium",
    srcs = ["tests/e2e.rs"],
    aliases = aliases(),
    data = [
        ":ovr",
        "//crates/ovrd",
    ],
    rustc_env = {
        "CARGO_BIN_EXE_ovr": "$(rootpath :ovr)",
        "OVRD": "$(rootpath //crates/ovrd)",
    },
    rustc_env_files = [":cargo_env"],
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + ["//crates/ovr-proto"],
)
