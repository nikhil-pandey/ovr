load("@crates//ovrd:data.bzl", "all_crate_deps", "crate_data")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

# The binary owns the package's default label, so first-party dependencies are listed by label.
LINT_CONFIG = crate_data().get("lint_config")

rust_library(
    name = "lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "ovrd",
    lint_config = LINT_CONFIG,
    rustc_env_files = ["//:cargo_env"],
    visibility = ["//crates/ovr:__pkg__"],
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ) + ["//crates/ovr-proto"],
)

rust_binary(
    name = "ovrd",
    srcs = ["src/main.rs"],
    lint_config = LINT_CONFIG,
    rustc_env_files = ["//:cargo_env"],
    visibility = ["//visibility:public"],
    deps = all_crate_deps(
        cargo_only = True,
        normal = True,
    ) + [
        ":lib",
        "//crates/ovr-proto",
    ],
)

rust_test(
    name = "ovrd-test",
    size = "small",
    crate = ":lib",
    lint_config = LINT_CONFIG,
    rustc_env_files = ["//:cargo_env"],
    visibility = ["//:__pkg__"],
    deps = all_crate_deps(
        cargo_only = True,
        normal_dev = True,
    ),
)
